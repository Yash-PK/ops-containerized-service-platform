{
  "name": "ops-container-platform-reference",
  "services": {
    "database": {
      "image": "library/postgres:18.6-trixie@sha256:74935e72241653ca55e0414067e6d8763aceb8a810eb51b452253ec3dcfc4336",
      "environment": {
        "POSTGRES_USER": "ops_owner",
        "POSTGRES_DB": "opsjobs",
        "POSTGRES_PASSWORD_FILE": "/run/secrets/owner_password",
        "POSTGRES_INITDB_ARGS": "--auth-host=scram-sha-256 --auth-local=scram-sha-256"
      },
      "secrets": [
        "owner_password"
      ],
      "volumes": [
        "database:/var/lib/postgresql"
      ],
      "networks": [
        "backend"
      ],
      "shm_size": "64m",
      "mem_limit": "256m",
      "cpus": 0.5,
      "pids_limit": 128,
      "security_opt": [
        "no-new-privileges:true"
      ],
      "healthcheck": {
        "test": [
          "CMD",
          "pg_isready",
          "-U",
          "ops_owner",
          "-d",
          "opsjobs"
        ],
        "interval": "3s",
        "timeout": "3s",
        "retries": 20,
        "start_period": "10s"
      },
      "stop_grace_period": "30s",
      "logging": {
        "driver": "local",
        "options": {
          "max-size": "1m",
          "max-file": "2"
        }
      }
    },
    "cache": {
      "init": true,
      "read_only": true,
      "security_opt": [
        "no-new-privileges:true"
      ],
      "cap_drop": [
        "ALL"
      ],
      "pids_limit": 64,
      "cpus": 0.5,
      "mem_limit": "64m",
      "tmpfs": [
        "/tmp:rw,noexec,nosuid,size=16m,mode=1777"
      ],
      "stop_grace_period": "10s",
      "logging": {
        "driver": "local",
        "options": {
          "max-size": "1m",
          "max-file": "2"
        }
      },
      "image": "valkey/valkey:9.1.2-trixie@sha256:418652cfb58ef879d4978c33553735d7147016032d5aefaa14c828e611eb9dfd",
      "user": "999:999",
      "entrypoint": [
        "/bin/sh",
        "/opt/cache.sh"
      ],
      "volumes": [
        "./containers/cache.sh:/opt/cache.sh:ro",
        "./containers/cache-health.sh:/opt/cache-health.sh:ro"
      ],
      "secrets": [
        "cache_password"
      ],
      "networks": [
        "backend"
      ],
      "healthcheck": {
        "test": [
          "CMD",
          "/bin/sh",
          "/opt/cache-health.sh"
        ],
        "interval": "3s",
        "timeout": "3s",
        "retries": 20,
        "start_period": "10s"
      }
    },
    "migrate": {
      "init": true,
      "read_only": true,
      "security_opt": [
        "no-new-privileges:true"
      ],
      "cap_drop": [
        "ALL"
      ],
      "pids_limit": 64,
      "cpus": 0.5,
      "mem_limit": "128m",
      "tmpfs": [
        "/tmp:rw,noexec,nosuid,size=16m,mode=1777"
      ],
      "stop_grace_period": "10s",
      "logging": {
        "driver": "local",
        "options": {
          "max-size": "1m",
          "max-file": "2"
        }
      },
      "image": "ops-container-platform-app:local",
      "pull_policy": "never",
      "user": "10001:10001",
      "networks": [
        "backend"
      ],
      "secrets": [
        "owner_password",
        "app_password"
      ],
      "command": [
        "python",
        "-m",
        "opsjobs.migrate"
      ],
      "environment": {
        "OPS_DB_USER": "ops_owner",
        "OPS_DB_PASSWORD_FILE": "/run/secrets/owner_password"
      },
      "depends_on": {
        "database": {
          "condition": "service_healthy"
        }
      }
    },
    "api": {
      "init": true,
      "read_only": true,
      "security_opt": [
        "no-new-privileges:true"
      ],
      "cap_drop": [
        "ALL"
      ],
      "pids_limit": 64,
      "cpus": 0.5,
      "mem_limit": "128m",
      "tmpfs": [
        "/tmp:rw,noexec,nosuid,size=16m,mode=1777"
      ],
      "stop_grace_period": "10s",
      "logging": {
        "driver": "local",
        "options": {
          "max-size": "1m",
          "max-file": "2"
        }
      },
      "image": "ops-container-platform-app:local",
      "pull_policy": "never",
      "user": "10001:10001",
      "networks": [
        "backend",
        "frontend"
      ],
      "secrets": [
        "app_password",
        "cache_password"
      ],
      "build": {
        "context": ".",
        "dockerfile": "Dockerfile"
      },
      "depends_on": {
        "migrate": {
          "condition": "service_completed_successfully"
        },
        "cache": {
          "condition": "service_healthy"
        }
      },
      "healthcheck": {
        "test": [
          "CMD",
          "python",
          "-m",
          "opsjobs.health",
          "api"
        ],
        "interval": "3s",
        "timeout": "3s",
        "retries": 20,
        "start_period": "10s"
      }
    },
    "worker": {
      "init": true,
      "read_only": true,
      "security_opt": [
        "no-new-privileges:true"
      ],
      "cap_drop": [
        "ALL"
      ],
      "pids_limit": 64,
      "cpus": 0.5,
      "mem_limit": "128m",
      "tmpfs": [
        "/tmp:rw,noexec,nosuid,size=16m,mode=1777"
      ],
      "stop_grace_period": "10s",
      "logging": {
        "driver": "local",
        "options": {
          "max-size": "1m",
          "max-file": "2"
        }
      },
      "image": "ops-container-platform-app:local",
      "pull_policy": "never",
      "user": "10001:10001",
      "networks": [
        "backend"
      ],
      "secrets": [
        "app_password",
        "cache_password"
      ],
      "command": [
        "python",
        "-m",
        "opsjobs.worker"
      ],
      "depends_on": {
        "migrate": {
          "condition": "service_completed_successfully"
        }
      },
      "healthcheck": {
        "test": [
          "CMD",
          "python",
          "-m",
          "opsjobs.health",
          "worker"
        ],
        "interval": "3s",
        "timeout": "3s",
        "retries": 20,
        "start_period": "10s"
      }
    },
    "proxy": {
      "init": true,
      "read_only": true,
      "security_opt": [
        "no-new-privileges:true"
      ],
      "cap_drop": [
        "ALL"
      ],
      "pids_limit": 64,
      "cpus": 0.5,
      "mem_limit": "64m",
      "tmpfs": [
        "/tmp:rw,noexec,nosuid,size=16m,mode=1777"
      ],
      "stop_grace_period": "10s",
      "logging": {
        "driver": "local",
        "options": {
          "max-size": "1m",
          "max-file": "2"
        }
      },
      "image": "library/nginx:1.30.5-trixie@sha256:9bf97bd7714f5e24c1ccd545ecb9eb5435cb6d109c97cebb15e7e455e0239edb",
      "user": "101:101",
      "entrypoint": [
        "nginx",
        "-g",
        "daemon off;"
      ],
      "volumes": [
        "./containers/nginx.conf:/etc/nginx/nginx.conf:ro"
      ],
      "networks": [
        "frontend"
      ],
      "ports": [
        "127.0.0.1:8080:8080"
      ],
      "depends_on": {
        "api": {
          "condition": "service_healthy"
        }
      },
      "healthcheck": {
        "test": [
          "CMD",
          "/bin/sh",
          "-c",
          "kill -0 \"$(cat /tmp/nginx.pid)\""
        ],
        "interval": "3s",
        "timeout": "3s",
        "retries": 20,
        "start_period": "10s"
      }
    },
    "seed": {
      "init": true,
      "read_only": true,
      "security_opt": [
        "no-new-privileges:true"
      ],
      "cap_drop": [
        "ALL"
      ],
      "pids_limit": 64,
      "cpus": 0.5,
      "mem_limit": "128m",
      "tmpfs": [
        "/tmp:rw,noexec,nosuid,size=16m,mode=1777"
      ],
      "stop_grace_period": "10s",
      "logging": {
        "driver": "local",
        "options": {
          "max-size": "1m",
          "max-file": "2"
        }
      },
      "image": "ops-container-platform-app:local",
      "pull_policy": "never",
      "user": "10001:10001",
      "networks": [
        "backend"
      ],
      "secrets": [
        "app_password",
        "cache_password"
      ],
      "command": [
        "python",
        "-m",
        "opsjobs.seed"
      ],
      "profiles": [
        "tools"
      ],
      "depends_on": {
        "migrate": {
          "condition": "service_completed_successfully"
        }
      }
    }
  },
  "networks": {
    "frontend": {
      "internal": true
    },
    "backend": {
      "internal": true
    }
  },
  "volumes": {
    "database": {
      "labels": {
        "io.ops.lab": "ops-container-platform-reference"
      }
    }
  },
  "secrets": {
    "owner_password": {
      "file": "./.runtime/secrets/owner_password"
    },
    "app_password": {
      "file": "./.runtime/secrets/app_password"
    },
    "cache_password": {
      "file": "./.runtime/secrets/cache_password"
    }
  }
}
